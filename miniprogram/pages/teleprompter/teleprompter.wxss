/* ==========================================================================
   提词页样式（对齐「浅纸提词器」）
   - 台词区：全量渲染，黑色底，左右 16px 内边距，行高由 JS 注入
   - 菜单：浅灰 #eee + 5 列 60px 网格 + 竖滑块（浅纸同款）
   ========================================================================== */

.tp-root {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  z-index: 1;
}

.tp-stage {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  transform-origin: center center;
}

/* 镜像：一张矩阵搞定，两个容器同时翻 */
.tp-mirror {
  transform: matrix(-1, 0, 0, 1, 0, 0);
}

/* ── 单 transform 容器 + 虚拟列表（原有逐帧滚动内核） ── */
.tp-viewport {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  overflow: hidden;
  z-index: 1;
}

.tp-content {
  width: 100%;
  box-sizing: border-box;
  will-change: transform;
}

.tp-hidden {
  opacity: 0;
  pointer-events: none;
}

/* ── 台词排版 ── */
.tp-pad {
  width: 100%;
  pointer-events: none;
}

.tp-lines {
  /* 宽度由 .tp-line 撑满，配合 inline marginHorizontal 控制台词区宽度 */
}

.tp-line {
  width: 100%;
  box-sizing: border-box;
  padding-left: calc(16px + env(safe-area-inset-left, 0px));
  padding-right: calc(16px + env(safe-area-inset-right, 0px));
  /* 折叠时盒子自动长高，行与行不可能重叠 */
  overflow: visible;
}

/* 对齐两档（居中 / 左对齐）。
   作用在块级 .tp-line 上，内部内联角色名与正文一起对齐。
   行盒用 min-height 而不是 height：万一某行被 CSS 折成两行，盒子会自己长高、
   把下一行往下推，绝不会压在一起（老版本写死 height，折行就直接叠字）。 */
.tp-align-left { text-align: left; }
.tp-align-center { text-align: center; }

/* 角色名：内联彩色，与正文同一行（原有实现） */
.tp-role {
  font-weight: 500;
}

.tp-body {
  white-space: pre-wrap;
  word-break: break-word;
  transition: opacity 0.18s ease;
}

/* 超长稿降级：整篇合成 1 个纯文本块，保留换行 */
.tp-blob-line {
  white-space: pre-wrap;
  overflow: visible;
}

.tp-blob {
  white-space: pre-wrap;
}

/* 聚焦模式：只留当前行前后一行 */
.tp-dim {
  opacity: 0.28;
}

/* ── 指示线 ── */
.tp-cue {
  position: fixed;
  left: 0;
  right: 0;
  height: 0;
  border-top: 1px dashed rgba(255, 82, 82, 0.45);
  z-index: 10;
  pointer-events: none;
}

.tp-cue-dot {
  position: absolute;
  left: 6px;
  top: -4px;
  width: 0;
  height: 0;
  border-top: 4px solid transparent;
  border-bottom: 4px solid transparent;
  border-left: 6px solid rgba(255, 82, 82, 0.75);
}

/* ── 读到底辉光 ── */
.tp-end-glow {
  position: fixed;
  left: 0;
  right: 0;
  bottom: -40px;
  height: 20px;
  box-shadow: 0 -20px 80px 20px rgba(255, 0, 0, 0.53);
  opacity: 0;
  transition: opacity 0.3s ease;
  pointer-events: none;
  z-index: 5;
}

.tp-end-glow--on {
  opacity: 1;
}

/* ── 时钟 ── */
.tp-clock {
  position: fixed;
  left: 0;
  right: 0;
  top: calc(env(safe-area-inset-top, 0px) + 10px);
  text-align: center;
  font-size: 12px;
  letter-spacing: 1px;
  color: rgba(255, 255, 255, 0.35);
  pointer-events: none;
  z-index: 20;
}

/* ── 右侧竖条进度 ── */
.tp-progress {
  position: fixed;
  right: 0;
  top: 0;
  bottom: 0;
  width: 14px;
  z-index: 30;
  background: linear-gradient(
    to right,
    rgba(0, 0, 0, 0) 0,
    rgba(0, 0, 0, 0) 11px,
    rgba(255, 255, 255, 0.14) 11px,
    rgba(255, 255, 255, 0.14) 14px
  );
}

.tp-progress-fill {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 3px;
  background: #ff5252;
  border-radius: 2px;
  transition: height 0.18s linear;
}

/* ── 右下角圆钮 ── */
.tp-fab {
  position: fixed;
  right: 16px;
  bottom: calc(env(safe-area-inset-bottom, 0px) + 16px);
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: rgba(253, 61, 61, 0.3);
  border: 1px solid rgba(253, 61, 61, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.tp-fab:active {
  background: rgba(255, 255, 255, 0.25);
}

.tp-fab-icon {
  color: rgba(255, 255, 255, 0.78);
  font-size: 17px;
  line-height: 1;
}

/* ── 倒计时 ── */
.tp-countdown {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.86);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.tp-countdown-num {
  font-size: 96px;
  font-weight: 200;
  color: #ffffff;
  line-height: 1;
}

.tp-countdown-tip {
  margin-top: 12px;
  font-size: 12px;
  color: rgba(255, 255, 255, 0.45);
  letter-spacing: 2px;
}

/* ==========================================================================
   菜单（浅灰网格，形态对齐浅纸 settings-panel）
   ========================================================================== */

.tp-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.22s ease;
  z-index: 300;
}

.tp-mask--on {
  opacity: 1;
  pointer-events: auto;
}

.tp-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 480px;
  max-height: 84vh;
  background: #efefef;
  border-radius: 16px 16px 0 0;
  box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.18);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transform: translateY(102%);
  transition: transform 0.26s cubic-bezier(0.22, 0.61, 0.36, 1);
  z-index: 310;
}

.tp-sheet--open {
  transform: translateY(0);
}

/* 横屏：右侧抽屉，半屏宽（浅纸 landscape 布局） */
.tp-sheet--land {
  left: auto;
  right: 0;
  top: 0;
  bottom: 0;
  width: 50%;
  height: 100%;
  max-height: none;
  border-radius: 0;
  transform: translateX(102%);
  box-shadow: -5px 2px 10px rgba(200, 200, 200, 0.5);
}

.tp-sheet--land.tp-sheet--open {
  transform: translateX(0);
}

.tp-sheet-head {
  flex: none;
  height: 40px;
  padding: 0 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #e9e9e9;
  border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

/* 横屏：抽屉贴在屏幕右侧，微信右上角的「··· ⊙」胶囊正好压在抽屉头部 ——
 * 老版本「切竖屏 / 退出 / ×」三个按钮全被胶囊盖住，点不到也看不见。
 * 处理：整个头部右让 112px（胶囊宽约 87 + 边距），工具组靠左排。 */
.tp-sheet-head--land {
  padding-top: env(safe-area-inset-top, 0px);
  padding-right: 112px;
  height: calc(40px + env(safe-area-inset-top, 0px));
  justify-content: flex-start;
}

/* 横屏时把标题让给按钮：半屏宽里塞不下「提词设置·横屏 + 三个按钮」 */
.tp-sheet-head--land .tp-sheet-title {
  display: none;
}

.tp-sheet-head--land .tp-sheet-tools {
  width: 100%;
  justify-content: flex-start;
}

.tp-sheet-title {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 13px;
  color: rgba(0, 0, 0, 0.55);
  letter-spacing: 0.5px;
}

.tp-sheet-tools {
  flex: none;
  display: flex;
  align-items: center;
}

.tp-head-btn {
  font-size: 12px;
  color: rgba(0, 0, 0, 0.62);
  padding: 4px 10px;
  border-radius: 8px;
  background: rgba(0, 0, 0, 0.07);
  margin-right: 8px;
}

.tp-head-close {
  width: 26px;
  height: 26px;
  line-height: 24px;
  text-align: center;
  font-size: 18px;
  color: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.05);
}

.tp-sheet-body {
  flex: 1;
  /* flex 子项的默认 min-height 是 auto —— iOS(WKWebView) 会让它撑到内容全高，
     被外层 overflow:hidden 裁掉且不产生滚动，菜单后半截（镜像/循环/聚焦/倒计时）就永远调不到。
     必须显式写 min-height:0 才会收缩成真正的滚动窗口。 */
  min-height: 0;
  background: #eeeeee;
}

/* 网格：浅纸原值 —— 60px 格 / 12px 间距 / auto-fit 居中（手机 4 列，窄屏 3 列）
 * 加 max-width：避免 iPad 上摊成 8–10 列，控件被拉得过散 */
.tp-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, 60px);
  grid-auto-rows: 60px;
  grid-auto-flow: row dense;
  grid-gap: 12px 12px;
  justify-content: center;
  align-items: start;
  padding: 16px;
  width: 100%;
  max-width: 420px;
  margin: 0 auto;
  box-sizing: border-box;
}

.tp-cell {
  position: relative;
  width: 100%;
  height: 100%;
  background: #dddddd;
  border-radius: 16px;
  overflow: hidden;
  text-align: center;
}

/* 竖滑块占两行（浅纸 .slider 同款） */
.tp-slider {
  grid-row: span 2;
}

/* 宽控件占两列 */
.tp-wide {
  grid-column: span 2;
}

/* 拉通整行：用于最后一个控件，避免末尾留半行空洞（用 1/-1 兼容 3–5 列） */
.tp-full {
  grid-column: 1 / -1;
}

.tp-cell-label {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 6px;
  font-size: 8px;
  line-height: 1.2;
  color: rgba(0, 0, 0, 0.42);
  pointer-events: none;
}

.tp-cell-val {
  position: absolute;
  left: 0;
  right: 0;
  top: 5px;
  font-size: 11px;
  line-height: 1.2;
  color: #333333;
  font-weight: 500;
  pointer-events: none;
}

.tp-unit {
  font-size: 7px;
  opacity: 0.55;
  margin-left: 1px;
}

/* 可点的数值：继承了 .tp-cell-val 的 pointer-events:none，这里要放开。
   z-index 必须高于 .tp-vhit（2），否则会被命中区盖住、点了变成拖滑块。 */
.tp-val-tap {
  pointer-events: auto;
  z-index: 3;
  color: #c62828;
  font-weight: 600;
}

/* 竖滑块 */
/* 命中区：只覆盖轨道上下这一段，不抢「数值区」的点击
   （数值区要留给「切单位 / 切显隐」，整格 catchtouchstart 会把它吃掉） */
.tp-vhit {
  position: absolute;
  left: 0;
  right: 0;
  top: 20px;
  bottom: 18px;
  z-index: 2;
}

.tp-vtrack {
  position: absolute;
  left: 50%;
  top: 26px;
  bottom: 22px;
  width: 4px;
  margin-left: -2px;
  background: rgba(0, 0, 0, 0.12);
  border-radius: 2px;
}

.tp-vfill {
  position: absolute;
  left: 0;
  bottom: 0;
  width: 100%;
  background: #ff5252;
  border-radius: 2px;
}

.tp-vthumb {
  position: absolute;
  left: 50%;
  width: 14px;
  height: 14px;
  margin-left: -7px;
  margin-bottom: -7px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
}

/* 横向滑块 */
.tp-hslider .tp-htrack {
  position: absolute;
  left: 10px;
  right: 10px;
  top: 42%;
  height: 4px;
  background: rgba(0, 0, 0, 0.12);
  border-radius: 2px;
}

.tp-hfill {
  height: 100%;
  background: #ff5252;
  border-radius: 2px;
}

.tp-hthumb {
  position: absolute;
  top: 50%;
  width: 14px;
  height: 14px;
  margin-left: -7px;
  margin-top: -7px;
  border-radius: 50%;
  background: #ffffff;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.25);
}

/* 色块 */
.tp-color {
  display: flex;
  align-items: flex-start;
  justify-content: center;
}

.tp-swatch {
  width: 20px;
  height: 20px;
  margin-top: 9px;
  border-radius: 50%;
  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.2);
}

/* 配色格：文字色 + 背景色两枚并排（替代原来的两个独立格） */
.tp-color-dual .tp-swatch {
  margin-top: 8px;
}

.tp-swatch-bg {
  margin-left: 6px;
  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.3);
}

/* 分段按钮（对齐方式）：两档等宽平铺，字号 10px 不会被裁 */
.tp-seg-cell {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-bottom: 12px;
  box-sizing: border-box;
}

.tp-seg-row {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
}

.tp-seg {
  flex: 1 1 0;
  white-space: nowrap;
  font-size: 10px;
  line-height: 1;
  padding: 6px 0;
  margin: 0 3px;
  border-radius: 10px;
  background: rgba(0, 0, 0, 0.07);
  color: rgba(0, 0, 0, 0.45);
  text-align: center;
  min-width: 0;
  box-sizing: border-box;
}

.tp-seg.is-on {
  background: #ff5252;
  color: #ffffff;
}

/* 开关 */
.tp-switch {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tp-dot {
  position: relative;
  width: 22px;
  height: 22px;
  margin-top: 11px;
  border-radius: 50%;
  /* #ddd 底上 0.1 的黑几乎看不见，提到 0.22 才能一眼认出「这是个开关」 */
  background: rgba(0, 0, 0, 0.22);
  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.05);
  transition: background 0.18s ease;
}

.tp-dot.is-on {
  background: #ff5252;
}

.tp-dot.is-on::after {
  content: '';
  position: absolute;
  left: 7px;
  top: 9px;
  width: 8px;
  height: 4px;
  border-left: 2px solid #ffffff;
  border-bottom: 2px solid #ffffff;
  transform: rotate(-45deg);
}

/* 颜色告警条 */
.tp-warn {
  display: flex;
  align-items: center;
  margin: 12px 16px 0;
  padding: 6px 8px;
  border-radius: 8px;
  background: rgba(255, 152, 0, 0.15);
  color: #b25e00;
  font-size: 11px;
  line-height: 1.4;
}

.tp-warn-dot {
  flex: none;
  width: 14px;
  height: 14px;
  line-height: 14px;
  text-align: center;
  border-radius: 50%;
  background: #ff9800;
  color: #ffffff;
  font-size: 10px;
  margin-right: 6px;
}

/* 底部操作 */
.tp-sheet-foot {
  display: flex;
  justify-content: center;
  padding: 4px 16px calc(env(safe-area-inset-bottom, 0px) + 18px);
}

.tp-foot-btn {
  font-size: 12px;
  color: rgba(0, 0, 0, 0.62);
  padding: 8px 18px;
  margin: 0 6px;
  border-radius: 10px;
  background: rgba(0, 0, 0, 0.07);
}

/* 调色盘 */
.tp-palette {
  position: absolute;
  left: 16px;
  right: 16px;
  bottom: 56px;
  background: #ffffff;
  border-radius: 12px;
  padding: 10px 12px 12px;
  box-shadow: 0 6px 24px rgba(0, 0, 0, 0.16);
  z-index: 5;
}

.tp-palette-title {
  font-size: 10px;
  color: rgba(0, 0, 0, 0.4);
  margin-bottom: 8px;
}

/* 托盘里第二、三段标题拉开距离 */
.tp-palette-title--gap {
  margin-top: 10px;
}

.tp-palette-row {
  display: flex;
  flex-wrap: wrap;
}

/* 托盘里的主题胶囊按内容宽度排，不参与平铺 */
.tp-palette .tp-seg {
  flex: none;
  padding: 6px 12px;
}

.tp-palette-dot {
  width: 26px;
  height: 26px;
  border-radius: 50%;
  margin: 4px 8px 4px 0;
  box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.15);
}

.tp-palette-dot.is-on {
  box-shadow: 0 0 0 2px #ff5252;
}

/* ── 引导（三段式：标题不滚 / 步骤可滚 / 按钮吸底）──
 * 尺寸一律「rpx 兜底 + vmin 覆盖」：rpx 按屏宽换算，横屏宽屏下会整体放大 2 倍，
 * 只剩半屏高度时按钮会被挤出视口。vmin 取宽高较小值，横竖屏视觉体量一致。
 */
.tp-guide-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.72);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 400;
}

.tp-guide-card {
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  width: 82%;
  max-width: 320px;
  max-width: 80vmin;
  max-height: 88vh;
  background: #1c1c1e;
  border-radius: 16px;
  padding: 22px 20px 16px;
  box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5);
}

.tp-guide-head {
  flex-shrink: 0;
}

.tp-guide-title {
  font-size: 32rpx;
  font-size: 5.2vmin;
  color: #ffffff;
  font-weight: 600;
}

.tp-guide-sub {
  margin-top: 6px;
  margin-bottom: 10px;
  font-size: 22rpx;
  font-size: 3.3vmin;
  color: rgba(255, 255, 255, 0.48);
}

.tp-guide-body {
  flex: 1 1 auto;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

.tp-guide-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 10px;
}

.tp-guide-txt {
  flex: 1 1 auto;
  min-width: 0;
}

.tp-guide-num {
  flex: none;
  width: 20px;
  height: 20px;
  line-height: 20px;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 82, 82, 0.22);
  color: #ff8a8a;
  font-size: 22rpx;
  font-size: 3.2vmin;
  margin-right: 10px;
  margin-top: 2px;
}

.tp-guide-b {
  font-size: 26rpx;
  font-size: 3.9vmin;
  color: #ffffff;
  line-height: 1.45;
}

.tp-guide-d {
  margin-top: 3px;
  font-size: 23rpx;
  font-size: 3.3vmin;
  color: rgba(255, 255, 255, 0.58);
  line-height: 1.45;
}

.tp-guide-btn {
  flex-shrink: 0;
  margin-top: 6px;
  height: 44px;
  line-height: 44px;
  text-align: center;
  border-radius: 12px;
  background: #ff5252;
  color: #ffffff;
  font-size: 28rpx;
  font-size: 4.2vmin;
}

/* 矮视口（横屏小手机 / 分屏）：收紧内边距与间距，保证三条步骤 + 按钮全在视口内 */
@media (max-height: 400px) {
  .tp-guide-card {
    padding: 14px 16px 12px;
  }

  .tp-guide-sub {
    margin-bottom: 8px;
  }

  .tp-guide-item {
    margin-bottom: 8px;
  }

  .tp-guide-btn {
    margin-top: 4px;
    height: 40px;
    line-height: 40px;
  }
}
