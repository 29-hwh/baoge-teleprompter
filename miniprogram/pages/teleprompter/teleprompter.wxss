.tp-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
}

/* 菜单/遮罩显隐：用 visibility + pointer-events 切换，而非 wx:if 插拔。
   元素始终在 DOM 中保持布局，打开时首帧就直接落在最终位置，
   根除「先插入到屏幕中上部闪一下、再被定位到底部」的底层渲染抖动（双击菜单闪现 bug）。 */
.tp-hidden {
  visibility: hidden;
  pointer-events: none;
  opacity: 0;
}

.tp-viewport {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  overflow: hidden;
}

.tp-content {
  will-change: transform;
  padding-top: 40vh;
}

.tp-line {
  white-space: nowrap;
  /* 不要裁切行内文字：解析器已保证每行字数不超预算，仅「行尾标点」会多占 1 字宽（避头尾规则），
     若用 overflow:hidden 会把名字/台词最后一个字裁掉（竖屏窄屏尤其明显）。改为 visible，
     多出的 1 字落在左右留白内，内容完整可见。 */
  overflow: visible;
}

.tp-role {
  font-weight: 600;
}

.tp-body {
  font-weight: 400;
}

/* 视线参考线 */
.tp-guide {
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  background: rgba(142, 142, 147, 0.5);
  pointer-events: none;
}

/* 电影字幕式上下渐隐遮罩：让匀速滚动的字幕在入/出屏处柔和淡出，呈现「片尾字幕」质感。
   渐变色由 wxml 内联写入（顶部=背景色→透明，底部=透明→背景色），随主题色自适应；
   这里只负责定位与穿透点击，绝不能拦截台词区的单击/双击。 */
.tp-fade {
  position: absolute;
  left: 0;
  right: 0;
  height: 16%;
  z-index: 8;
  pointer-events: none;
}

.tp-fade--top {
  top: 0;
}

.tp-fade--bottom {
  bottom: 0;
}

/* 进度条（可拖动定位）：底部常驻细条，播放时也能随时拖动定位 */
.tp-progress-wrap {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 56rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  background: rgba(28, 28, 30, 0.6);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  z-index: 20;
}

.tp-slider {
  margin: 0;
  width: 100%;
}

/* 声控指示 */
.tp-voice {
  position: absolute;
  top: 96rpx;
  left: 24rpx;
  width: 220rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(28, 28, 30, 0.55);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

.tp-voice-label {
  font-size: 22rpx;
  color: #7BE0AD;
  margin-bottom: 10rpx;
  font-weight: 500;
}

.tp-voice-track {
  height: 8rpx;
  background: rgba(142, 142, 147, 0.4);
  border-radius: 999rpx;
  overflow: hidden;
}

.tp-voice-fill {
  height: 100%;
  background: #7BE0AD;
  transition: width 80ms linear;
}

.tp-voice-tip {
  font-size: 20rpx;
  color: rgba(235, 235, 245, 0.6);
  margin-top: 8rpx;
}

/* 倒计时 */
.tp-countdown {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40; /* 高于菜单(26)/顶栏(30)/遮罩(25)，倒计时期间必定整体可见 */
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.tp-countdown-num {
  font-size: 200rpx;
  color: #FFD166;
  font-weight: 600;
}

/* 顶部栏（毛玻璃） */
.tp-topbar {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  z-index: 30; /* 菜单遮罩(25)之上，返回/设置始终可点 */
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx 24rpx;
  background: rgba(28, 28, 30, 0.5);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
}

.tp-title {
  flex: 1;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.tp-icon {
  font-size: 28rpx;
  font-weight: 500;
  color: #FFD166;
  padding: 8rpx 16rpx;
}

/* Req 2：播放中（未暂停）顶栏按键降到 10% 透明度，避免抢视线；暂停后恢复全亮 */
.tp-icon.tp-dim {
  opacity: 0.1;
}

.tp-icon {
  transition: opacity 0.2s ease;
}

/* 台本位置角标（第 N / 共 M） */
.tp-pos {
  font-size: 24rpx;
  font-weight: 500;
  color: rgba(235, 235, 245, 0.7);
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(118, 118, 128, 0.32);
  margin-left: 12rpx;
}

/* 菜单遮罩：半透明区域，点它关闭菜单（需求 4） */
.tp-controls-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.35);
  z-index: 25;
}

/* 底部控制条（毛玻璃面板） */
.tp-controls {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 56rpx;
  z-index: 26; /* 在遮罩(25)之上，按钮可点；catchtap 吸收面板内点击不外溢 */
  padding: 28rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  background: rgba(28, 28, 30, 0.62);
  backdrop-filter: blur(28px);
  -webkit-backdrop-filter: blur(28px);
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
  border-top-left-radius: 28rpx;
  border-top-right-radius: 28rpx;
}

/* 菜单内容滚动区：内容超高时上下滑动看全所有功能 */
.tp-menu-scroll {
  width: 100%;
}

/* 菜单内容包裹层：JS 用它实测内容自然高，决定菜单贴内容高还是限高滚动 */
.tp-menu-inner {
  width: 100%;
}

/* 横屏菜单：最多占屏幕 1/5（需求 4），
   这里只收紧留白与字号——横屏 rpx 按屏幕宽度换算会整体放大，
   实际高度上限由 JS 按 winHeight * 20% 写进内联 style（menuHeight） */
.tp-controls--landscape {
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  bottom: 20rpx;
}

.tp-controls--landscape .tp-row {
  margin-bottom: 8rpx;
}

.tp-controls--landscape .tp-btn {
  padding: 8rpx 18rpx;
  font-size: 22rpx;
  margin-right: 12rpx;
  margin-bottom: 4rpx;
}

.tp-controls--landscape .tp-step {
  padding: 8rpx 16rpx;
  font-size: 22rpx;
}

.tp-controls--landscape .tp-theme-chip {
  padding: 10rpx 0;
  font-size: 20rpx;
}

.tp-controls--landscape .tp-hint {
  font-size: 18rpx;
  margin-top: 6rpx;
}

.tp-controls--landscape .tp-mini {
  font-size: 20rpx;
}

/* 横屏：菜单最多占屏幕 1/5，所以行距/内边距全部再压一档，
   让同样高度里能塞进更多行，少滚动 */
.tp-controls--landscape .tp-menu-inner {
  padding-bottom: 4rpx;
}

.tp-controls--landscape .tp-row {
  margin-bottom: 4rpx;
}

.tp-controls--landscape .tp-btn {
  padding: 6rpx 14rpx;
  font-size: 20rpx;
  margin-right: 8rpx;
  margin-bottom: 2rpx;
  border-radius: 999rpx;
}

.tp-controls--landscape .tp-step-val {
  font-size: 20rpx;
  padding: 0 10rpx;
  min-width: 48rpx;
}

.tp-controls--landscape .tp-speed-slider {
  height: 28rpx;
  margin: 0 10rpx;
}

.tp-controls--landscape .tp-hint {
  font-size: 16rpx;
  margin-top: 4rpx;
}

/* 滚动方式分段选择：两个紧凑小按钮（第三档「逐段」已下架） */
.tp-style-row {
  flex-wrap: nowrap;
}

.tp-seg {
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
}

.tp-controls--landscape .tp-seg {
  padding: 6rpx 16rpx;
  font-size: 20rpx;
  margin-right: 8rpx;
}

.tp-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  margin-bottom: 18rpx;
}

.tp-row:last-child {
  margin-bottom: 0;
}

.tp-btn {
  padding: 14rpx 30rpx;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
  border-radius: 999rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: #ffffff;
  background: rgba(118, 118, 128, 0.32);
}

.tp-btn.primary {
  background: #FFD166;
  color: #1C1C1E;
}

.tp-btn.on {
  background: #34C759;
  color: #ffffff;
}

/* 切换台本的上/下一个按钮：到边界置灰、不可点（明确不循环） */
.tp-btn.is-disabled {
  background: rgba(118, 118, 128, 0.12);
  color: rgba(235, 235, 245, 0.3);
  pointer-events: none;
}

.tp-btn.tiny-btn {
  background: transparent;
  color: rgba(235, 235, 245, 0.6);
  padding-left: 0;
}

.tp-stepper {
  display: flex;
  align-items: center;
  margin-right: 16rpx;
  margin-bottom: 8rpx;
  background: rgba(118, 118, 128, 0.32);
  border-radius: 999rpx;
  overflow: hidden;
}

.tp-step {
  padding: 14rpx 26rpx;
  font-size: 27rpx;
  font-weight: 500;
  color: #ffffff;
}

.tp-step-val {
  padding: 0 18rpx;
  font-size: 26rpx;
  color: #FFD166;
  min-width: 64rpx;
  text-align: center;
}

/* 速度滑块行 */
.tp-speed-row {
  align-items: center;
}

.tp-mini {
  font-size: 24rpx;
  color: rgba(235, 235, 245, 0.7);
  flex-shrink: 0;
}

.tp-mini-val {
  min-width: 72rpx;
  text-align: center;
  color: #FFD166;
}

.tp-speed-slider {
  flex: 1;
  margin: 0 20rpx;
}

/* 三个文字/背景预设（一键配色） */
.tp-theme-row {
  justify-content: space-between;
}

.tp-theme-chip {
  flex: 1;
  margin-right: 16rpx;
  padding: 18rpx 0;
  text-align: center;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  font-size: 24rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.tp-theme-chip:last-child {
  margin-right: 0;
}

.tp-finished {
  font-size: 25rpx;
  color: #7BE0AD;
  margin-top: 10rpx;
}

.tp-hint {
  font-size: 21rpx;
  color: rgba(235, 235, 245, 0.4);
  margin-top: 10rpx;
}

/* 首次使用引导
   ------------------------------------------------------------------
   尺寸：整体按 0.85 等比缩小（500→440rpx 宽，字号 40/29/23→34/26/21）。
   原来卡片实测约 800rpx 高，而提词页是**横屏**使用（375px 视口 = 750rpx），
   底部「开始提词」按钮会被裁掉；所以除了缩小，还做了两道兜底：
     ① max-height: 84vh —— 卡片永不超过视口高度；
     ② 三段式布局：标题固定 / 步骤区可滚 / 主按钮吸底 ——
        即使极端小屏，主操作按钮也永远在最下方可见（位置明确）。 */
.tp-guide-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 60;
}

.tp-guide-card {
  width: 68%;
  max-width: 440rpx;
  max-height: 84vh;
  display: flex;
  flex-direction: column;
  background: rgba(44, 44, 46, 0.94);
  backdrop-filter: blur(30px);
  -webkit-backdrop-filter: blur(30px);
  border-radius: 22rpx;
  padding: 28rpx 26rpx 24rpx;
  box-sizing: border-box;
}

/* 标题区：不参与滚动，始终在卡片顶部 */
.tp-guide-head {
  flex-shrink: 0;
}

.tp-guide-title {
  font-size: 34rpx;
  color: #ffffff;
  font-weight: 600;
  text-align: center;
}

.tp-guide-sub {
  font-size: 22rpx;
  color: rgba(235, 235, 245, 0.55);
  text-align: center;
  margin-top: 8rpx;
}

/* 步骤区：内容超高时可滚（min-height:0 是 flex 子项能滚动的前提） */
.tp-guide-body {
  flex: 1;
  min-height: 0;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  margin-top: 22rpx;
}

.tp-guide-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.tp-guide-item:last-child {
  margin-bottom: 0;
}

.tp-guide-ico {
  font-size: 32rpx;
  color: #7BE0AD;
  width: 52rpx;
  flex-shrink: 0;
  line-height: 1.35;
}

.tp-guide-txt {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-width: 0;
}

.tp-guide-b {
  font-size: 26rpx;
  color: #ffffff;
  font-weight: 500;
  line-height: 1.35;
}

.tp-guide-d {
  font-size: 21rpx;
  color: rgba(235, 235, 245, 0.55);
  margin-top: 4rpx;
  line-height: 1.45;
}

/* 主按钮：吸底不滚，位置永远明确 */
.tp-guide-btn {
  flex-shrink: 0;
  margin-top: 18rpx;
  background: #FFD166;
  color: #1C1C1E;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 14rpx;
}

/* ============ 横屏适配（需求 3） ============ */

/* 顶栏的返回/设置：横屏缩小 */
.tp-topbar.tp-land .tp-icon {
  font-size: 22rpx;
  padding: 6rpx 12rpx;
}

.tp-topbar.tp-land .tp-title {
  font-size: 26rpx;
}

/* 底部进度条：横屏缩小高度，并约 50% 透明 */
.tp-progress-wrap.tp-land {
  height: 34rpx;
  opacity: 0.5;
  padding: 0 16rpx;
}

/* 注：按角色筛选的旧菜单样式（.tp-role-filter-row / .tp-role-chips / .tp-role-chip）
   已随「滚动页菜单角色选择板块」下架——筛选改由编辑页「角色显示选择」配置驱动，
   提词页不再有对应 DOM，故整块样式删除，不留死代码。 */
