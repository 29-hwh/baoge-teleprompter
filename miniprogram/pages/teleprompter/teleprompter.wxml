<!--
  提词页（恢复原有逐帧滚动内核 + 浅纸菜单）
  ──────────────────────────────────────────────────────────────
  与「一条动画跑到底」版本的根本差别：
    1) 恢复虚拟列表：只渲染视口附近的行，长稿不卡。
    2) 单一 transform 容器：translate3d(0, -offset, 0)，ScrollEngine 逐帧推 offset。
    3) 角色名内联渲染（rolePrefix + body 同一行），行高等高。
    4) 菜单网格 + 竖滑块 + 横竖屏切换，与浅纸同构。
    5) 安全区以 JS 读到的 safeArea 为准，通过 CSS 变量下发（env() 在安卓常为 0）。
-->
<view
  class="tp-root"
  style="background: {{bg}}; --safe-t: {{safeTop}}px; --safe-b: {{safeBottom}}px; --safe-l: {{safeLeft}}px; --safe-r: {{safeRight}}px;"
>
  <view class="tp-stage {{mirror ? 'tp-mirror' : ''}}">

    <!-- ── 提词内容区：单 transform 容器 + 虚拟列表 ── -->
    <view
      class="tp-viewport"
      bindtap="onTapScreen"
      bindtouchstart="onTouchStart"
      bindtouchmove="onTouchMove"
      bindtouchend="onTouchEnd"
      bindtouchcancel="onTouchCancel"
    >
      <view
        class="tp-content"
        style="transform: translate3d(0, {{-offset}}px, 0); will-change: transform; font-family: {{fontFamily}};"
      >
        <view class="tp-pad" style="height: {{startPad}}px;"></view>
        <!-- 全量渲染：滚动期间只有外层 transform 变，列表一个节点都不重建 -->
        <view class="tp-lines" style="margin: 0 {{marginHorizontal}}px;">
          <view
            class="tp-line tp-align-{{textAlign}} {{line.blob ? 'tp-blob-line' : ''}}"
            wx:for="{{lines}}"
            wx:key="_i"
            wx:for-item="line"
            style="{{line.blob ? '' : 'min-height: ' + lineHeightPx + 'px; line-height: ' + lineHeightPx + 'px;'}}"
          >
            <text
              wx:if="{{line.rolePrefix && !line.blob}}"
              class="tp-role"
              style="color: {{line.prefixColor}}; font-size: {{fontSizePx}}px; letter-spacing: {{letterSpacing}}px;"
            >{{line.rolePrefix}}</text><text
              class="tp-body {{line.blob ? 'tp-blob' : ''}} {{!line.blob && focus && status !== 'stopped' && (line._i < focusIndex - 1 || line._i > focusIndex + 1) ? 'tp-dim' : ''}}"
              style="color: {{line.bodyColor}}; font-size: {{fontSizePx}}px; letter-spacing: {{letterSpacing}}px; {{fontBold ? 'font-weight: 700;' : ''}}"
            >{{line.body}}</text>
          </view>
        </view>
        <view class="tp-pad" style="height: {{endPad}}px;"></view>
      </view>
    </view>

    <!-- 视线指示线（位置 0–90 可调） -->
    <view wx:if="{{showCue}}" class="tp-cue" style="top: {{cuePosition}}%;">
      <view class="tp-cue-dot"></view>
    </view>

    <!-- 读到底：底部红色辉光（浅纸同款） -->
    <view class="tp-end-glow {{finished ? 'tp-end-glow--on' : ''}}"></view>
  </view>

  <!-- 时钟：位置由 JS 读到的安全区决定（刘海/挖孔屏不会压住），
       不依赖 env() —— 该变量在部分安卓机型恒为 0 -->
  <view wx:if="{{showClocks}}" class="tp-clock" style="top: {{safeTop + 8}}px;">{{clockText}}</view>

  <!-- 右侧竖条进度：可拖、可点 -->
  <view
    class="tp-progress"
    catchtouchstart="onProgressTouchStart"
    catchtouchmove="onProgressTouchMove"
    catchtouchend="onProgressTouchEnd"
    catchtouchcancel="onProgressTouchEnd"
  >
    <view class="tp-progress-fill" style="height: {{progressValue}}%;"></view>
  </view>

  <!-- 右下角红色圆钮：打开设置菜单（浅纸 script-fab 同款）
       right/bottom 都要让开安全区：横屏右侧刘海 + 底部 Home 指示条 -->
  <view
    class="tp-fab"
    style="right: {{safeRight + 16}}px; bottom: {{safeBottom + 16}}px;"
    catchtap="onOpenMenu"
  >
    <view class="tp-fab-icon">☰</view>
  </view>

  <!-- 开场倒计时 -->
  <view wx:if="{{countdown > 0}}" class="tp-countdown">
    <view class="tp-countdown-num">{{countdown}}</view>
    <view class="tp-countdown-tip">即将开始</view>
  </view>

  <!-- ── 菜单：底部抽屉（竖屏）/ 右侧抽屉（横屏） ── -->
  <view class="tp-mask {{showMenu ? 'tp-mask--on' : ''}}" catchtap="onCloseMenu"></view>

  <view
    class="tp-sheet {{orientation === 'landscape' ? 'tp-sheet--land' : ''}} {{showMenu ? 'tp-sheet--open' : ''}}"
    catchtap="noop"
  >
    <view class="tp-sheet-head {{orientation === 'landscape' ? 'tp-sheet-head--land' : ''}}">
      <view class="tp-sheet-title">提词设置 · {{orientation === 'landscape' ? '横屏' : '竖屏'}}</view>
      <view class="tp-sheet-tools">
        <view class="tp-head-btn" catchtap="onToggleOrientation">{{orientation === 'landscape' ? '切竖屏' : '切横屏'}}</view>
        <view class="tp-head-btn" catchtap="onTapBack">退出</view>
        <view class="tp-head-close" catchtap="onCloseMenu">×</view>
      </view>
    </view>

    <scroll-view scroll-y class="tp-sheet-body" enhanced show-scrollbar="{{false}}" bindscroll="onSheetScroll">
      <view wx:if="{{colorWarning}}" class="tp-warn">
        <text class="tp-warn-dot">!</text>
        <text>文字颜色与背景颜色过于接近，可能看不清台词</text>
      </view>

      <view class="tp-grid">

        <!-- ── 一组：字的排布（速度/字号/行距/字距）──────────────────── -->
        <!-- 速度：竖滑块。点上方数值切单位（字/分 ⇄ 像素），原「速度单位」格已并入。
             ⚠️ data-slider 不能省：事件挂在 .tp-vhit 上，e.currentTarget 指向的就是它，
             没有 data-slider / id 时取到空字符串 → 滑块点了完全没反应（速度"锁死"的真因）。 -->
        <view
          id="vs-speed"
          class="tp-cell tp-slider"
          data-key="speed"
          data-slider="vs-speed"
          catchtouchstart="onVSliderStart"
          catchtouchmove="onVSliderMove"
          catchtouchend="onVSliderEnd"
          catchtouchcancel="onVSliderEnd"
          catchtap="noop"
        >
          <view class="tp-vhit">
            <view class="tp-vtrack">
              <view class="tp-vfill" style="height: {{pctSpeed}}%;"></view>
              <view class="tp-vthumb" style="bottom: {{pctSpeed}}%;"></view>
            </view>
          </view>
          <view class="tp-cell-val tp-val-tap" catchtap="onToggleSpeedUnit">{{speedText}}</view>
          <!-- 引擎实际速度：拖动时跟着变，用来确认「调的数值真的到了引擎」。
               只读、不抢触摸（pointer-events:none） -->
          <view class="tp-cell-px">{{speedPxPerSec}}px/s</view>
          <view class="tp-cell-label">速度<text class="tp-unit">{{speedUnitText}}</text></view>
        </view>

        <!-- 字号 -->
        <view
          id="vs-fontSize"
          class="tp-cell tp-slider"
          data-key="fontSize"
          data-slider="vs-fontSize"
          catchtouchstart="onVSliderStart"
          catchtouchmove="onVSliderMove"
          catchtouchend="onVSliderEnd"
          catchtouchcancel="onVSliderEnd"
          catchtap="noop"
        >
          <view class="tp-vhit">
            <view class="tp-vtrack">
              <view class="tp-vfill" style="height: {{pctFontSize}}%;"></view>
              <view class="tp-vthumb" style="bottom: {{pctFontSize}}%;"></view>
            </view>
          </view>
          <view class="tp-cell-val">{{settings.fontSize}}</view>
          <view class="tp-cell-label">字号</view>
        </view>

        <!-- 行距 -->
        <view
          id="vs-lineHeight"
          class="tp-cell tp-slider"
          data-key="lineHeight"
          data-slider="vs-lineHeight"
          catchtouchstart="onVSliderStart"
          catchtouchmove="onVSliderMove"
          catchtouchend="onVSliderEnd"
          catchtouchcancel="onVSliderEnd"
          catchtap="noop"
        >
          <view class="tp-vhit">
            <view class="tp-vtrack">
              <view class="tp-vfill" style="height: {{pctLineHeight}}%;"></view>
              <view class="tp-vthumb" style="bottom: {{pctLineHeight}}%;"></view>
            </view>
          </view>
          <view class="tp-cell-val">{{settings.lineHeight}}</view>
          <view class="tp-cell-label">行距</view>
        </view>

        <!-- 字距 -->
        <view
          id="vs-letterSpacing"
          class="tp-cell tp-slider"
          data-key="letterSpacing"
          data-slider="vs-letterSpacing"
          catchtouchstart="onVSliderStart"
          catchtouchmove="onVSliderMove"
          catchtouchend="onVSliderEnd"
          catchtouchcancel="onVSliderEnd"
          catchtap="noop"
        >
          <view class="tp-vhit">
            <view class="tp-vtrack">
              <view class="tp-vfill" style="height: {{pctLetterSpacing}}%;"></view>
              <view class="tp-vthumb" style="bottom: {{pctLetterSpacing}}%;"></view>
            </view>
          </view>
          <view class="tp-cell-val">{{settings.letterSpacing}}</view>
          <view class="tp-cell-label">字距</view>
        </view>

        <!-- ── 二组：对齐与版心 ───────────────────────────────────── -->
        <!-- 对齐两档（居中 / 左对齐），两档才排得下，不再挤成一坨 -->
        <view class="tp-cell tp-wide tp-seg-cell">
          <view class="tp-seg-row">
            <view
              wx:for="{{alignOptions}}"
              wx:key="key"
              wx:for-item="opt"
              class="tp-seg {{settings.textAlign === opt.key ? 'is-on' : ''}}"
              data-key="{{opt.key}}"
              catchtap="onSetAlign"
            >{{opt.label}}</view>
          </view>
          <view class="tp-cell-label">对齐</view>
        </view>

        <!-- 台词区宽度（宽 2 格，横向滑块） -->
        <view
          id="hs-contentWidth"
          class="tp-cell tp-wide tp-hslider"
          data-key="contentWidth"
          data-slider="hs-contentWidth"
          catchtouchstart="onHSliderStart"
          catchtouchmove="onHSliderMove"
          catchtouchend="onHSliderEnd"
          catchtouchcancel="onHSliderEnd"
          catchtap="noop"
        >
          <view class="tp-htrack">
            <view class="tp-hfill" style="width: {{pctWidth}}%;"></view>
            <view class="tp-hthumb" style="left: {{pctWidth}}%;"></view>
          </view>
          <view class="tp-cell-val">{{settings.contentWidth}}%</view>
          <view class="tp-cell-label">台词区宽度</view>
        </view>

        <!-- ── 三组：字重与字体 ───────────────────────────────────── -->
        <!-- 文字加粗 -->
        <view class="tp-cell tp-switch" catchtap="onToggleBold">
          <view class="tp-dot {{settings.fontBold ? 'is-on' : ''}}"></view>
          <view class="tp-cell-label">文字加粗</view>
        </view>

        <!-- 字体：系统 → 宋体 → 楷体 → 等宽 循环 -->
        <view class="tp-cell tp-switch" catchtap="onToggleFontFamily">
          <view class="tp-dot {{settings.fontFamily && settings.fontFamily !== 'system' ? 'is-on' : ''}}"></view>
          <view class="tp-cell-label">{{fontFamilyLabel}}</view>
        </view>

        <!-- ── 四组：配色与辅助线 ─────────────────────────────────── -->
        <!-- 配色（宽 2 格）：文字色 + 背景色 + 主题预设，全部收进一个托盘 -->
        <view class="tp-cell tp-wide tp-color tp-color-dual" catchtap="onOpenColor">
          <view class="tp-swatch" style="background: {{settings.textColor}};"></view>
          <view class="tp-swatch tp-swatch-bg" style="background: {{settings.backgroundColor}};"></view>
          <view class="tp-cell-label">配色</view>
        </view>

        <!-- 指示线：竖滑块调位置，点数值切显隐（原独立「参考线」开关已并入） -->
        <view
          id="vs-cuePosition"
          class="tp-cell tp-slider"
          data-key="cuePosition"
          data-slider="vs-cuePosition"
          catchtouchstart="onVSliderStart"
          catchtouchmove="onVSliderMove"
          catchtouchend="onVSliderEnd"
          catchtouchcancel="onVSliderEnd"
          catchtap="noop"
        >
          <view class="tp-vhit">
            <view class="tp-vtrack">
              <view class="tp-vfill" style="height: {{pctCue}}%;"></view>
              <view class="tp-vthumb" style="bottom: {{pctCue}}%;"></view>
            </view>
          </view>
          <view class="tp-cell-val tp-val-tap" catchtap="onToggleCue">{{settings.showCue === false ? '关' : settings.cuePosition + '%'}}</view>
          <view class="tp-cell-label">指示线</view>
        </view>

        <!-- ── 五组：起播与画面 ───────────────────────────────────── -->
        <!-- 底部开始 -->
        <view class="tp-cell tp-switch" catchtap="onToggleStartPosition">
          <view class="tp-dot {{settings.startPosition === 'bottom' ? 'is-on' : ''}}"></view>
          <view class="tp-cell-label">底部开始</view>
        </view>

        <!-- 镜像 -->
        <view class="tp-cell tp-switch" catchtap="onToggleMirror">
          <view class="tp-dot {{settings.mirror ? 'is-on' : ''}}"></view>
          <view class="tp-cell-label">镜像</view>
        </view>

        <!-- 循环 -->
        <view class="tp-cell tp-switch" catchtap="onToggleLoop">
          <view class="tp-dot {{settings.loop ? 'is-on' : ''}}"></view>
          <view class="tp-cell-label">循环</view>
        </view>

        <!-- 聚焦 -->
        <view class="tp-cell tp-switch" catchtap="onToggleFocus">
          <view class="tp-dot {{settings.focus ? 'is-on' : ''}}"></view>
          <view class="tp-cell-label">聚焦</view>
        </view>

        <!-- 时间 -->
        <view class="tp-cell tp-switch" catchtap="onToggleClocks">
          <view class="tp-dot {{settings.showClocks ? 'is-on' : ''}}"></view>
          <view class="tp-cell-label">时间</view>
        </view>

        <!-- 补光（宝哥独有） -->
        <view class="tp-cell tp-switch" catchtap="onToggleFillLight">
          <view class="tp-dot {{settings.fillLight ? 'is-on' : ''}}"></view>
          <view class="tp-cell-label">补光</view>
        </view>

        <!-- 角色高亮（宝哥独有）。点子反映「画面上真的有没有颜色」：
             总闸开着时即使设置为开也不亮，点一下即解除总闸 -->
        <view class="tp-cell tp-switch" catchtap="onToggleRoleHighlight">
          <view class="tp-dot {{roleHighlight ? 'is-on' : ''}}"></view>
          <view class="tp-cell-label">角色色</view>
        </view>

        <!-- ── 六组：跟读与收尾 ───────────────────────────────────── -->
        <!-- 声控跟读（宝哥独有） -->
        <view class="tp-cell tp-switch" catchtap="onToggleVoice">
          <view class="tp-dot {{voiceEnabled ? 'is-on' : ''}}"></view>
          <view class="tp-cell-label">声控</view>
        </view>

        <!-- 倒计时（拉通整行，最后一格不留空洞） -->
        <view
          id="hs-countdown"
          class="tp-cell tp-full tp-hslider"
          data-key="countdown"
          data-slider="hs-countdown"
          catchtouchstart="onHSliderStart"
          catchtouchmove="onHSliderMove"
          catchtouchend="onHSliderEnd"
          catchtouchcancel="onHSliderEnd"
          catchtap="noop"
        >
          <view class="tp-htrack">
            <view class="tp-hfill" style="width: {{pctCountdown}}%;"></view>
            <view class="tp-hthumb" style="left: {{pctCountdown}}%;"></view>
          </view>
          <view class="tp-cell-val">{{settings.countdown}}s</view>
          <view class="tp-cell-label">倒计时</view>
        </view>

        <!-- 智能总闸（漏词兜底，与编辑页/设置页同源） -->
        <view class="tp-cell tp-switch" catchtap="onToggleSmartOff">
          <view class="tp-dot {{smartOff ? 'is-on' : ''}}"></view>
          <view class="tp-cell-label">智能总闸</view>
        </view>

        <!-- 屏幕常亮 -->
        <view class="tp-cell tp-switch" catchtap="onToggleKeepScreenOn">
          <view class="tp-dot {{settings.keepScreenOn !== false ? 'is-on' : ''}}"></view>
          <view class="tp-cell-label">屏幕常亮</view>
        </view>

      </view>

      <view class="tp-sheet-foot">
        <view class="tp-foot-btn" catchtap="onReplayGuide">新手引导</view>
        <view class="tp-foot-btn" catchtap="onResetSettings">恢复默认</view>
        <view class="tp-foot-btn" catchtap="onTapBack">退出提词</view>
      </view>
    </scroll-view>

    <!-- 配色托盘：主题快捷 + 文字色 + 背景色（原本 3 个入口合成 1 个） -->
    <view wx:if="{{colorPicker}}" class="tp-palette" catchtap="noop">
      <view class="tp-palette-title">主题</view>
      <view class="tp-palette-row">
        <view
          wx:for="{{themePresets}}"
          wx:key="key"
          wx:for-item="t"
          class="tp-seg {{settings.textColor === t.text && settings.backgroundColor === t.bg ? 'is-on' : ''}}"
          data-bg="{{t.bg}}"
          data-text="{{t.text}}"
          catchtap="onTapTheme"
        >{{t.short}}</view>
      </view>
      <view class="tp-palette-title tp-palette-title--gap">文字色</view>
      <view class="tp-palette-row">
        <view
          wx:for="{{textColors}}"
          wx:key="*this"
          wx:for-item="c"
          class="tp-palette-dot {{settings.textColor === c ? 'is-on' : ''}}"
          style="background: {{c}};"
          data-kind="text"
          data-color="{{c}}"
          catchtap="onPickColor"
        ></view>
      </view>
      <view class="tp-palette-title tp-palette-title--gap">背景色</view>
      <view class="tp-palette-row">
        <view
          wx:for="{{bgColors}}"
          wx:key="*this"
          wx:for-item="c"
          class="tp-palette-dot {{settings.backgroundColor === c ? 'is-on' : ''}}"
          style="background: {{c}};"
          data-kind="bg"
          data-color="{{c}}"
          catchtap="onPickColor"
        ></view>
      </view>
    </view>
  </view>

  <!-- 首次使用引导 -->
  <view wx:if="{{guideVisible}}" class="tp-guide-mask" catchtap="onCloseGuide">
    <view class="tp-guide-card" catchtap="noop">
      <view class="tp-guide-head">
        <view class="tp-guide-title">提词页 · 三步上手</view>
        <view class="tp-guide-sub">先认三个手势，其余跟着感觉来</view>
      </view>
      <scroll-view class="tp-guide-body" scroll-y>
        <view class="tp-guide-item">
          <text class="tp-guide-num">1</text>
          <view class="tp-guide-txt">
            <view class="tp-guide-b">点一下屏幕 = 播放 / 暂停</view>
            <view class="tp-guide-d">整块屏幕都是开关，不用低头找按钮</view>
          </view>
        </view>
        <view class="tp-guide-item">
          <text class="tp-guide-num">2</text>
          <view class="tp-guide-txt">
            <view class="tp-guide-b">按住可拖，松手续播</view>
            <view class="tp-guide-d">上下滑动翻页，拖右侧竖条快速跳位</view>
          </view>
        </view>
        <view class="tp-guide-item">
          <text class="tp-guide-num">3</text>
          <view class="tp-guide-txt">
            <view class="tp-guide-b">右下角红色圆钮 = 设置菜单</view>
            <view class="tp-guide-d">字号、速度、配色、镜像、横竖屏，全在里面</view>
          </view>
        </view>
      </scroll-view>
      <view class="tp-guide-btn" bindtap="onCloseGuide">开始提词</view>
    </view>
  </view>
</view>
