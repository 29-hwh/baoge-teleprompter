/* 设置页（去重后）：只保留「说明 + 去哪改 + 版本」三块的样式。
   .container / .btn / .btn-block 走 app.wxss 全局，不在这里重复定义。 */

/* 顶部说明条：告诉用户真正的设置入口在提词页菜单 */
.hint-bar {
  margin-top: 8rpx;
  padding: 24rpx 26rpx;
  border-radius: 18rpx;
  background: rgba(255, 82, 82, 0.12);
  border: 1rpx solid rgba(255, 82, 82, 0.28);
}

.hint-title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--accent);
  margin-bottom: 8rpx;
}

.hint-sub {
  font-size: 23rpx;
  line-height: 1.55;
  color: var(--text-secondary);
}

.group-title {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: var(--text-tertiary);
  margin: 32rpx 8rpx 14rpx;
}

.group-card {
  background: var(--bg-card);
  border-radius: 20rpx;
  overflow: hidden;
}

.line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 28rpx;
}

.line-label {
  font-size: 28rpx;
  color: var(--text);
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.line-value {
  font-size: 25rpx;
  color: var(--text-tertiary);
  flex: none;
  text-align: right;
}

.line-sep {
  height: 1rpx;
  background: var(--border);
  margin-left: 28rpx;
}

/* 直达菜单按钮：与上方卡片拉开距离 */
.tap-block {
  margin-top: 40rpx;
}

.safe-bottom {
  height: calc(20rpx + env(safe-area-inset-bottom));
}
