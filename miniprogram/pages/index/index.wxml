<!--
  首页 · 台本库
  ──────────────────────────────────────────────────────────────
  视觉定位：片场稿纸（Call Sheet）
    · 暖纸底 + 墨黑字 + 朱红点（红只做「套准标 / 当前页签 / 开拍」）
    · 衬线标题 + 等宽数字，做出印刷品的编辑感
    · 细线分隔、大留白，让「最近在改」成为唯一焦点
  结构（自上而下）：
    1) 报头：栏目名 / 大标题 + 设置 / 三个数字画像
    2) 主操作：新建（墨黑实底）+ 导入（描边）
    3) 焦点卡「RECENT · 最近在改」：整卡点击直接开播，右上「改稿」进编辑
    4) 分区文字页签（下划线指示，替代药丸）
    5) 列表：文件夹=分节线，台本=稿纸卡；末尾一条「新建」收尾
    6) 版权页
  适配：navigationStyle=custom，报头整体落在「状态栏 + 胶囊带」之下，
        左右内边距叠加横屏刘海安全区（style 里的 --safe-l / --safe-r）。
-->
<view class="idx" style="--safe-l: {{safeL}}px; --safe-r: {{safeR}}px;">

  <!-- ── 报头 ── -->
  <view class="idx-head" style="padding-top: {{headTop}}px">
    <view class="idx-kicker">
      <view class="idx-kicker-dot"></view>
      <text>BAOGE · TELEPROMPTER</text>
    </view>

    <view class="idx-masthead">
      <view class="idx-title">台本</view>
      <view class="idx-gear" hover-class="press-soft" bindtap="onTapSettings" aria-role="button" aria-label="设置">
        <view class="idx-gear-line"></view>
        <view class="idx-gear-line"></view>
        <view class="idx-gear-line"></view>
      </view>
    </view>

    <view class="idx-figures">
      <text class="idx-num idx-num--lg">{{totalCount}}</text><text class="idx-fig-u">篇</text>
      <text class="idx-fig-sep">/</text>
      <text class="idx-num">{{folderCount}}</text><text class="idx-fig-u">组</text>
      <text class="idx-fig-sep">/</text>
      <text class="idx-num">{{totalCharsText}}</text><text class="idx-fig-u">字</text>
    </view>
  </view>

  <!-- 报头下细线：只留一根发丝线，不加装饰段（加了会读成「595」的下划线） -->
  <view class="idx-rule"></view>

  <!-- ── 主操作 ── -->
  <view wx:if="{{totalCount > 0}}" class="idx-actions">
    <view class="idx-act idx-act--solid" hover-class="press-ink" bindtap="onTapNew">
      <view class="idx-ico idx-ico--plus"></view>
      <text>新建台本</text>
    </view>
    <view class="idx-act idx-act--ghost" hover-class="press-soft" bindtap="onTapImport">
      <view class="idx-ico idx-ico--down"></view>
      <text>导入文档</text>
    </view>
  </view>

  <!-- ── 焦点卡：最近在改 ── -->
  <view
    wx:if="{{resume && totalCount > 0}}"
    class="idx-hero"
    data-id="{{resume.id}}"
    bindtap="onTapPrompt"
    hover-class="press"
  >
    <view class="idx-hero-top">
      <view class="idx-hero-tag">
        <view class="idx-hero-tag-dot"></view>
        <text>RECENT · 最近在改</text>
      </view>
      <view
        class="idx-hero-edit"
        data-id="{{resume.id}}"
        catchtap="onTapItem"
        hover-class="press-text"
      >改稿</view>
    </view>

    <view class="idx-hero-title">{{resume.title}}</view>
    <view class="idx-hero-pre">{{resume.preview || '（空白台本）'}}</view>

    <view class="idx-hero-foot">
      <view class="idx-hero-fig">
        <text class="idx-num">{{resume.charsText}}</text><text class="idx-u">字</text>
        <block wx:if="{{resume.roleCount > 0}}">
          <text class="idx-hero-sep">/</text>
          <text class="idx-num">{{resume.roleCount}}</text><text class="idx-u">角色</text>
        </block>
        <text class="idx-hero-sep">/</text>
        <text class="idx-hero-time">{{resume.updatedText}}</text>
      </view>
      <view class="idx-hero-play" data-id="{{resume.id}}" catchtap="onTapPrompt" hover-class="press-play">
        <view class="idx-tri"></view>
        <text>开始提词</text>
      </view>
    </view>
  </view>

  <!-- ── 分区页签（文字 + 下划线，不用药丸）── -->
  <scroll-view wx:if="{{totalCount > 0}}" class="idx-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="idx-tab {{filter === 'all' ? 'on' : ''}}" data-key="all" bindtap="onSwitchFilter">
      <text>全部</text><text class="idx-tab-n">{{totalCount}}</text>
    </view>
    <view class="idx-tab {{filter === 'split' ? 'on' : ''}}" data-key="split" bindtap="onSwitchFilter">
      <text>拆分台本</text><text class="idx-tab-n">{{splitCount}}</text>
    </view>
    <view class="idx-tab {{filter === 'single' ? 'on' : ''}}" data-key="single" bindtap="onSwitchFilter">
      <text>单篇</text><text class="idx-tab-n">{{singleCount}}</text>
    </view>
  </scroll-view>

  <view wx:if="{{storageTip}}" class="idx-tip">
    <view class="idx-tip-bar"></view>
    <text>{{storageTip}}</text>
  </view>

  <!-- ── 空态：一张打格稿纸 ── -->
  <view wx:if="{{empty}}" class="idx-empty">
    <view class="idx-sheet">
      <view class="idx-sheet-red"></view>
      <view class="idx-sheet-row"></view>
      <view class="idx-sheet-row"></view>
      <view class="idx-sheet-row"></view>
    </view>
    <view class="idx-empty-title">{{totalCount ? '这个分区还没有台本' : '还没有台本'}}</view>
    <view class="idx-empty-sub">粘贴一段台词自己排，或从聊天记录导入 txt / docx</view>
    <view class="idx-empty-acts">
      <view class="idx-empty-btn idx-empty-btn--solid" hover-class="press-ink" bindtap="onTapNew">新建台本</view>
      <view class="idx-empty-btn" hover-class="press-soft" bindtap="onTapImport">导入文档</view>
    </view>
  </view>

  <!-- ── 列表 ── -->
  <view wx:if="{{!empty}}" class="idx-list">
    <block wx:for="{{list}}" wx:key="id" wx:for-item="item">

      <!-- 文件夹：不做成卡片，做成一条分节线 -->
      <view
        wx:if="{{item.kind === 'folder'}}"
        class="idx-folder {{item.collapsed ? 'is-collapsed' : ''}}"
        data-fid="{{item.fid}}"
        data-name="{{item.name}}"
        data-count="{{item.count}}"
        bindtap="onTapFolder"
        bindlongpress="onLongPressFolder"
        hover-class="press-soft"
      >
        <view class="idx-folder-head">
          <view class="idx-folder-tick"></view>
          <view class="idx-folder-name">{{item.name}}</view>
          <view class="idx-folder-right">
            <text class="idx-folder-count">{{item.count}} 篇</text>
            <view
              class="idx-folder-arrow {{item.collapsed ? 'is-folded' : ''}}"
              catchtap="onToggleFolder"
              data-fid="{{item.fid}}"
            ></view>
          </view>
        </view>
        <view class="idx-folder-meta">
          <text>{{item.collapsed ? '已收起' : item.updatedText}}</text>
          <text class="idx-folder-hint">点名字改名 · 长按删整组</text>
        </view>
      </view>

      <!-- 分节说明：单篇台本与上面的文件夹组分属两类，必须有可见边界 -->
      <view wx:if="{{item.kind === 'section'}}" class="idx-sec">
        <view class="idx-sec-name">{{item.name}}</view>
        <view class="idx-sec-line"></view>
        <text class="idx-sec-n">{{item.count}} 篇</text>
      </view>

      <!-- 台本卡：整卡点击进编辑，「提词」直达提词页 -->
      <view
        wx:if="{{item.kind === 'script'}}"
        class="idx-card {{item.inFolder ? 'in-folder' : ''}}"
        data-id="{{item.id}}"
        data-title="{{item.title}}"
        bindtap="onTapItem"
        bindlongpress="onLongPress"
        hover-class="press"
      >
        <view class="idx-card-head">
          <view class="idx-card-title">{{item.title}}</view>
          <view wx:if="{{item.roleCount > 0}}" class="idx-chip">{{item.roleCount}} 角色</view>
        </view>
        <view class="idx-card-pre">{{item.preview || '（空白台本）'}}</view>
        <view class="idx-card-foot">
          <view class="idx-card-fig">
            <text class="idx-num">{{item.charsText}}</text><text class="idx-u">字</text>
            <text class="idx-card-dot">·</text>
            <text>{{item.updatedText}}</text>
          </view>
          <view class="idx-play" data-id="{{item.id}}" catchtap="onTapPrompt" hover-class="press-play">
            <view class="idx-tri idx-tri--sm"></view>
            <text>提词</text>
          </view>
        </view>
      </view>
    </block>

    <!-- 列表收尾：滚到最底也能直接开新稿，不必再滑回顶部 -->
    <view class="idx-more" hover-class="press-soft" bindtap="onTapNew">
      <view class="idx-ico idx-ico--plus idx-ico--plus-ink"></view>
      <text>再新建一篇</text>
    </view>

    <view class="idx-list-foot">长按台本可删除 · 本机保存，不上传云端</view>
  </view>

  <!-- ── 文件夹重命名 ── -->
  <view wx:if="{{folderRenameVisible}}" class="idx-mask" bindtap="onFolderRenameCancel">
    <view class="idx-dialog" catchtap="noop">
      <view class="idx-dialog-kicker">FOLDER</view>
      <view class="idx-dialog-title">文件夹命名</view>
      <input
        class="idx-dialog-input"
        placeholder-class="idx-ph"
        value="{{folderRenameName}}"
        maxlength="30"
        placeholder="给文件夹起个名字"
        focus="{{true}}"
        bindinput="onFolderNameInput"
        bindconfirm="onFolderRenameOk"
      />
      <view class="idx-dialog-btns">
        <view class="idx-dialog-btn" hover-class="press-soft" bindtap="onFolderRenameCancel">取消</view>
        <view class="idx-dialog-btn idx-dialog-btn--solid" hover-class="press-ink" bindtap="onFolderRenameOk">确定</view>
      </view>
    </view>
  </view>

  <!-- ── 版权页（跟随内容，不悬浮：悬浮会永久压住列表最后一屏）── -->
  <view class="idx-foot">
    <view class="idx-foot-line"></view>
    <view class="idx-foot-row">
      <text class="idx-foot-ver">{{version}}</text>
      <text class="idx-foot-sep">·</text>
      <text class="idx-foot-txt">{{footerCopyright}}</text>
      <text class="idx-foot-sep">·</text>
      <text class="idx-foot-txt">{{footerUpdate}}</text>
    </view>
  </view>
</view>
