.header {
  margin-bottom: 28rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 0.5rpx;
}

.icon-btn {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--border-strong);
  font-size: 26rpx;
  color: var(--accent);
}

.tip-bar {
  background: rgba(10, 132, 255, 0.12);
  color: var(--accent);
  font-size: 24rpx;
  padding: 18rpx 24rpx;
  border-radius: 14rpx;
  margin-bottom: 24rpx;
}

.script-item {
  margin-bottom: 18rpx;
}

/* 分区切换栏：全部 / 拆分台本 / 单篇台本（需求 6：拆分导入的台本独立成区，可一键只看） */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.filter-tab {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  font-weight: 500;
  color: var(--text-secondary);
  background: var(--bg-card);
  border: 1rpx solid var(--border);
  border-radius: 999rpx;
}

.filter-tab.on {
  color: #ffffff;
  background: var(--accent);
  border-color: var(--accent);
}

/* 文件夹内的台本：左侧缩进一条线，视觉上从属于文件夹 */
.in-folder {
  margin-left: 28rpx;
  margin-bottom: 14rpx;
  background: var(--bg-card);
  border-left: 4rpx solid rgba(10, 132, 255, 0.45);
}

/* 文件夹标题卡 */
.folder-head {
  margin: 28rpx 0 14rpx;
  padding: 20rpx 24rpx;
  border-radius: 18rpx;
  background: rgba(10, 132, 255, 0.1);
  border: 1rpx solid rgba(10, 132, 255, 0.3);
}

.folder-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--accent);
  max-width: 500rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.folder-count {
  font-size: 24rpx;
  color: var(--accent);
  background: rgba(10, 132, 255, 0.18);
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
}

.folder-right {
  align-items: center;
  flex-shrink: 0;
}

.folder-arrow {
  margin-left: 14rpx;
  font-size: 30rpx;
  line-height: 1;
  color: var(--accent);
  padding: 6rpx 12rpx;
  border-radius: 10rpx;
}

.folder-arrow:active {
  background: rgba(10, 132, 255, 0.14);
}

.folder-head.is-collapsed {
  background: rgba(10, 132, 255, 0.06);
}

.folder-meta {
  margin-top: 10rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(10, 132, 255, 0.18);
}

/* 文件夹重命名弹窗 */
.rename-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  z-index: 60;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rename-card {
  width: 600rpx;
  background: var(--bg-elevated);
  border-radius: 24rpx;
  padding: 36rpx 32rpx 28rpx;
}

.rename-title {
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 24rpx;
  text-align: center;
}

.rename-input {
  background: var(--bg-card);
  border-radius: 14rpx;
  padding: 18rpx 22rpx;
  font-size: 30rpx;
  margin-bottom: 30rpx;
  /* 原生输入框需显式配色，避免当前名字呈默认黑字看不清（点击编辑文字不可见） */
  color: #ffffff;
}

.ed-ph {
  color: #636366;
}

.rename-btns {
  justify-content: center;
}

.rename-btn {
  flex: 1;
  margin: 0 10rpx;
  text-align: center;
}

.btn-ghost {
  background: var(--bg-card);
  color: var(--text);
}

.script-title {
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
  max-width: 460rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-badge {
  color: var(--accent);
  background: rgba(10, 132, 255, 0.16);
}

.script-preview {
  font-size: 26rpx;
  color: var(--text-secondary);
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.script-meta {
  border-top: 1rpx solid var(--border);
  padding-top: 16rpx;
}

.action-bar {
  position: sticky;
  top: 0;
  z-index: 40;
  background: var(--bg);
  border-bottom: 1rpx solid var(--border);
  padding: 4rpx 0 18rpx;
}

.btn-import {
  margin-top: 20rpx;
  color: var(--text-secondary);
}

/* 首页容器底部留白：保证最后一张卡片 / 操作按钮不被固定页脚遮挡 */
.container {
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

/* 页脚：固定停靠屏幕底部，始终展示版本号；半透明分隔线 + 纯黑底，避免与列表内容混淆 */
.app-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 18rpx 32rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: var(--bg);
  border-top: 1rpx solid var(--border);
}

.footer-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

/* 版本号突出显示：用强调色小药丸，醒目但不喧宾夺主 */
.footer-ver {
  font-size: 26rpx;
  font-weight: 700;
  color: #1C1C1E;
  background: var(--accent);
  border-radius: 999rpx;
  padding: 4rpx 18rpx;
  letter-spacing: 0.5rpx;
}

.footer-sep,
.footer-dot {
  color: var(--text-tertiary);
}

.footer-tag {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.footer-sub {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}
